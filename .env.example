# Copy to services/api/.env (never commit the real file).
# Nebius Token Factory (OpenAI-compatible). Key is server-side only.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Confirm exact IDs with: uv run python ../../scripts/smoke_nebius.py --list-models
NEBIUS_MODEL_PLANNER=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b

# live = real Nebius calls; mock = deterministic scripted provider (dev/CI only, always labelled in UI)
AI_MODE=mock

# Budgets for one recovery run
AGENT_MAX_MODEL_CALLS=6
AGENT_MAX_TOTAL_TOKENS=60000
AGENT_TIMEOUT_SECONDS=90

# Comma-separated origins allowed to call the API in development
CORS_ORIGINS=http://localhost:3000
